{
  "name": "code-cortex",
  "displayName": "CodeCortex",
  "description": "CodeCortex — contexto controlado para entender código, consultar documentação e analisar impactos com o Copilot.",
  "version": "0.0.1",
  "publisher": "guilherme-local",
  "author": {
    "name": "Guilherme"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guilherme-Humberto/code-cortex"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "icon": "assets/code-cortex-extension-icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-cortex",
          "title": "CodeCortex",
          "icon": "assets/code-cortex-white.svg"
        }
      ]
    },
    "views": {
      "code-cortex": [
        {
          "id": "code-cortex-view",
          "name": "CodeCortex",
          "type": "webview",
          "icon": "assets/code-cortex-white.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codeCortex_knowledge_search",
        "title": "CodeCortex: Pesquisar sobre o código"
      },
      {
        "command": "codeCortex_knowledge_searchFiles",
        "title": "CodeCortex: Pesquisar sobre os arquivos em foco"
      },
      {
        "command": "codeCortex.addToImpact",
        "title": "CodeCortex: Adicionar arquivos"
      },
      {
        "command": "codeCortex.removeFromImpact",
        "title": "CodeCortex: Remover arquivos"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codeCortex_knowledge_search",
          "when": "editorTextFocus && editorHasSelection",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "codeCortex.addToImpact",
          "when": "resourceFilename",
          "group": "navigation"
        }
      ],
      "view/title": []
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --expose-gc ./node_modules/.bin/jest --logHeapUsage --passWithNoTests --noStackTrace",
    "test:unit": "npm run test -- --config ./jest.config.js --runInBand --detectOpenHandles --silent --no-cache",
    "test:coverage": "npm run test:unit -- --coverage --detectOpenHandles",
    "test:extension": "npm run compile-tests && node ./out/test/suite/extension.test.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "glob": "^11.0.3",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "mammoth": "^1.12.1"
  }
}
